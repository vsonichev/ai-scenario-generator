# Данные для подключения к сервисам

# Активный провайдер генерации текста:
# glm — тесты (Z.ai), ollama — прод (gpt-oss:20b на Ollama:local)
LLM_PROVIDER=ollama

# Конфигурация БД с pgvector
DB_HOST=address
DB_PORT=port
DB_USER=user_name
DB_PASSWORD=password
DB_NAME=db_name

# -----------------------------------------------------------------
# Провайдер LLM_PROVIDER=ollama: Ollama:local с gpt-oss:20b
OLLAMA_LOCAL_URL=http://<IP:PORT>/v1         # Адрес Ollama на локальной машине с GPU
OLLAMA_LOCAL_KEY=ollama
OLLAMA_LOCAL_MODEL=gpt-oss:20b               # Модель для генерации текста
OLLAMA_LOCAL_TEMPERATURE=0.1                 # Температура для рассуждения локальной модели
OLLAMA_LOCAL_REASONING_EFFORT=low            # Уровень рассуждения gpt-oss: low / medium / high


# Провайдер LLM_PROVIDER=glm: Z.ai
GLM_URL=https://api.z.ai/api/coding/paas/v4  # альтернатива для openai-клиента (Coding Plan)
GLM_KEY=your_key                             # API-ключ Z.ai
GLM_MODEL=glm-5.3                            # Название модели
GLM_TEMPERATURE=0.1
GLM_REASONING_EFFORT=low                     # low / medium / high
# -----------------------------------------------------------------

# Эмбеддер запросов пользователя (Ollama:sandbox)
OLLAMA_SANDBOX_URL=http://<IP:PORT>/v1       # Адрес Ollama в sandbox
OLLAMA_SANDBOX_KEY=ollama
OLLAMA_SANDBOX_EMBEDDING=qwen3-embedding:4b  # Имя модели в sandbox
